// =============================================================================
//  wrangler.jsonc — the whole px deployment: one Worker, one container class.
//
//  Worker  : gates every request behind Cloudflare Access, serves the browser
//            UI from Static Assets, and forwards the Wisp WebSocket to the
//            caller's relay container.
//  Container: `WispRelay` — a byte relay (see container/), sized for `lite`
//            (1/16 vCPU, 256 MiB). It never parses or renders a web page.
//
//  Deploy with `npx wrangler deploy` (needs Docker locally to build the image)
//  after filling in the two Access values under "vars". See README.md.
// =============================================================================
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "px-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Only the custom domain serves this Worker: no *.workers.dev hostname and
  // no preview URLs, so there is no path around the Access policy on the zone.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "px.tinyorbit.org", "custom_domain": true }],

  // The browser UI plus the vendored proxy runtime (public/scram, public/baremux,
  // public/epoxy are generated by `npm run build`). `run_worker_first` makes
  // every asset request pass through the Worker's Access check first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "containers": [
    {
      "class_name": "WispRelay",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      // lite = 1/16 vCPU, 256 MiB, 2 GB. Step up to "basic" (1/4 vCPU, 1 GiB)
      // only if a single user's page loads feel throttled — see README.md.
      "instance_type": "lite",
      // Upper bound on simultaneously running relays. With RELAY_MODE=per-user
      // this is the number of people who can be online at once.
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "WispRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WispRelay"] }],

  "vars": {
    // Zero Trust team domain, e.g. https://myteam.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "https://REPLACE-ME.cloudflareaccess.com",
    // Application Audience (AUD) tag of the Access application for px.tinyorbit.org
    "ACCESS_AUD": "REPLACE-ME",
    // "per-user": one relay container per signed-in email (default).
    // "shared":   everyone shares a single relay container.
    "RELAY_MODE": "per-user",
    // How long a relay stays up after its last WebSocket frame before it is
    // stopped (and stops being billed). Cold start on the next connect is a
    // few seconds.
    "RELAY_SLEEP_AFTER": "5m"
  },

  // Copies the Scramjet / bare-mux / epoxy runtime from node_modules into
  // public/ before `wrangler dev` and `wrangler deploy`.
  "build": { "command": "node scripts/sync-vendor.mjs" },

  "observability": { "enabled": true },
  "dev": { "port": 8787 }
}
